{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "cost": {
            "input": 10,
            "output": 50
          }
        },
        "claude-fable-5.1": {
          "name": "claude-fable-5.1",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "cost": {
            "input": 10,
            "output": 50
          }
        }
      }
    },
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{file:~/.config/opencode/meta-api-key}"
      },
      "models": {
        "muse-spark-1.1": {
          "name": "Muse Spark 1.1",
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        }
      }
    }
  },
  "model": "meta/muse-spark-1.1",
  "tools": {
    "builder-mcp_MechanicRunTool": false
  },
  "mcp": {
    "builder-mcp": {
      "type": "local",
      "command": ["builder-mcp"]
    },
    "semantic-scholar": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "semantic-scholar-mcp"]
    },
    "arxiv": {
      "type": "local",
      "command": ["uvx", "arxiv-mcp-server"]
    },
    "zotero": {
      "type": "local",
      "command": ["zotero-mcp", "serve"]
    },
    "pandoc": {
      "type": "local",
      "command": ["uvx", "mcp-pandoc"]
    },
    "playwright": {
      "type": "local",
      "command": ["/Users/roydipta/.local/bin/playwright-mcp"]
    },
    "duckduckgo": {
      "type": "local",
      "command": ["npx", "-y", "@oevortex/ddg_search"]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "enabled": true,
      "timeout": 30000
    },
    "docling": {
      "type": "local",
      "command": ["docling-mcp-server", "--transport", "stdio", "conversion", "generation"],
      "environment": {
        "DOCLING_MCP_CONVERSION_MODE": "local"
      },
      "enabled": true,
      "timeout": 120000
    }
  }
}
